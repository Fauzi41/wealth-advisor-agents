# --- Optional LLM configuration -------------------------------------------
# The system runs fully WITHOUT any LLM or API key. Set these only to enable
# LLM-generated narratives (the template fallback is used otherwise).

LLM_PROVIDER=          # anthropic | openai
LLM_MODEL=             # e.g. claude-sonnet-4-5 or gpt-4o-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Never commit a real .env file containing keys.
